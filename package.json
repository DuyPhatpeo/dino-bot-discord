{
  "name": "dinobot-monorepo",
  "version": "1.2.0",
  "private": true,
  "description": "Monorepo for DinoBot Discord and DinoBotWeb",
  "workspaces": [
    "bot",
    "web"
  ],
  "scripts": {
    "start": "node bot/src/index.js",
    "bot:start": "npm --prefix bot start",
    "bot:dev": "npm --prefix bot run dev",
    "bot:deploy": "npm --prefix bot run deploy",
    "bot:clear": "npm --prefix bot run clear",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:preview": "npm --prefix web run preview"
  }
}
